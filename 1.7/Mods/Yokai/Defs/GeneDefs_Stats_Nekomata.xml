<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Copy of DZ_CaitSith_Stats for Big and Small - Yokai's nekomata.
       Parent DZ_CatfolkStatsBase lives in 1.6/Defs/GeneDefs_Stats.xml. -->
  <GeneDef ParentName="DZ_CatfolkStatsBase">
    <defName>DZ_Nekomata_Stats</defName>
    <label>nekomata trickery</label>
    <description>Carriers of this gene have the innate agility of the nekomata.</description>
    <statOffsets>
      <!-- VEF stat, rolled in its Projectile.ImpactSomething patch. -->
      <VEF_RangedDodgeChance>0.1</VEF_RangedDodgeChance>
    </statOffsets>
    <statFactors>
      <PawnTrapSpringChance>0.8</PawnTrapSpringChance>
    </statFactors>
  </GeneDef>

</Defs>
