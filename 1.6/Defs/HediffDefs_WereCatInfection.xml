<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Infection chain, modelled on Vampires and the Undead's werewolf bite:
       night claw hediff -> own tool capacity -> maneuver -> damage def whose additionalHediffs
       seed DZ_Felinthropy on the victim -> at full severity the framework's TransitioningHediff
       swaps the victim onto the Werecat xenotype. Pure XML. -->

  <HediffDef>
    <defName>DZ_WereCatClaws</defName>
    <label>were-cat claws</label>
    <description>Wicked feline claws. Scratches can pass on felinthropy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <SM_UnarmedAttackSpeed>0.05</SM_UnarmedAttackSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_VerbGiver">
        <tools>
          <li>
            <label>claws</label>
            <!-- Only the infecting capacity, so every claw hit uses the infecting maneuver. -->
            <capacities>
              <li>DZ_WereCatScratchCap</li>
            </capacities>
            <power>11</power>
            <chanceFactor>2</chanceFactor>
            <cooldownTime>2.0</cooldownTime>
            <armorPenetration>0.2</armorPenetration>
          </li>
        </tools>
      </li>
    </comps>
    <addedPartProps>
      <betterThanNatural>false</betterThanNatural>
    </addedPartProps>
  </HediffDef>

  <ToolCapacityDef>
    <defName>DZ_WereCatScratchCap</defName>
    <label>were-cat scratch</label>
  </ToolCapacityDef>

  <ManeuverDef>
    <defName>DZ_WereCatScratch</defName>
    <requiredCapacity>DZ_WereCatScratchCap</requiredCapacity>
    <verb>
      <verbClass>Verb_MeleeAttackDamage</verbClass>
      <ai_IsWeapon>false</ai_IsWeapon>
      <meleeDamageDef>DZ_WereCatScratchDmg</meleeDamageDef>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Slash_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Slash_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Slash_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Slash_MeleeDodge</combatLogRulesDodge>
  </ManeuverDef>

  <DamageDef ParentName="CutBase">
    <defName>DZ_WereCatScratchDmg</defName>
    <label>were-cat scratch</label>
    <additionalHediffs>
      <li>
        <hediff>DZ_Felinthropy</hediff>
        <severityPerDamageDealt>0.005</severityPerDamageDealt>
        <victimSeverityScaling>ToxicResistance</victimSeverityScaling>
        <inverseStatScaling>true</inverseStatScaling>
        <victimSeverityScalingByInvBodySize>true</victimSeverityScalingByInvBodySize>
      </li>
    </additionalHediffs>
    <applyAdditionalHediffsIfHuntingForFood>false</applyAdditionalHediffsIfHuntingForFood>
  </DamageDef>

  <!-- Copy of VU_Lycantropy's numbers. Untreated it runs to full severity in about a day and
       converts; tending and immunity fight it. lethalSeverity sits just above the conversion
       point, so a victim never dies of it before converting. -->
  <HediffDef>
    <defName>DZ_Felinthropy</defName>
    <label>felinthropy</label>
    <description>This person has been infected by felinthropy from a were-cat's claws. It is crucial that they get medical treatment.</description>
    <isBad>true</isBad>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1.05</lethalSeverity>
    <tendable>true</tendable>
    <initialSeverity>0.01</initialSeverity>
    <hediffClass>BigAndSmall.TransitioningHediff</hediffClass>
    <stages>
      <li>
        <label>aching scratches</label>
        <minSeverity>0.15</minSeverity>
        <painOffset>0.15</painOffset>
        <statFactors>
          <RestFallRateFactor>1.6</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>warped scratches</label>
        <minSeverity>0.85</minSeverity>
        <painOffset>0.60</painOffset>
        <statFactors>
          <RestFallRateFactor>1.4</RestFallRateFactor>
        </statFactors>
      </li>
      <li>
        <label>shifting</label>
        <minSeverity>0.92</minSeverity>
        <painOffset>0.10</painOffset>
        <statFactors>
          <RestFallRateFactor>1.4</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>9</baseTendDurationHours>
        <severityPerDayTended>-0.5</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>1.00</severityPerDayNotImmune>
        <immunityPerDaySick>0.85</immunityPerDaySick>
        <severityPerDayImmune>-2.0</severityPerDayImmune>
        <immunityPerDayNotSick>-1.0</immunityPerDayNotSick>
      </li>
    </comps>
    <modExtensions>
      <li Class="BigAndSmall.TransitioningHediffProps">
        <onSeverity>
          <li>
            <severity>1.00</severity>
            <trigger>
              <xenoTypeToAdd>DZ_WereCat</xenoTypeToAdd>
              <hediffsToRemove>
                <li>DZ_Felinthropy</li>
              </hediffsToRemove>
            </trigger>
          </li>
        </onSeverity>
      </li>
    </modExtensions>
  </HediffDef>

</Defs>
