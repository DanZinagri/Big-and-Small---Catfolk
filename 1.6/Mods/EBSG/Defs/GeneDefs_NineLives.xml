<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Nine lives, built on EBSG Framework's MultipleLives comp (same pattern as Highborn's
       "lesser deaths"). Folder is gated on EBSG.Framework via LoadFolders. No DLC needed.
       Revive is automatic for every pawn after hoursToRevive; daysToRecoverLife is left at 0 so
       the nine charges never refill. Severity tracks lives left (useSeverityNotDays): each death
       subtracts (maxSeverity - 0.001) / 8, and the stages below just relabel the count.
       Eight revives = nine lives counting the one they were born with. -->

  <GeneDef>
    <defName>DZ_NineLives</defName>
    <label>nine lives</label>
    <description>Carriers of this gene have nine lives: the one they were born with and eight returns from death, provided the brain survives. Spent lives never come back.</description>
    <customEffectDescriptions>
      <li>Grants 8 revives (nine lives in all). A revive triggers automatically if the brain is intact and takes 12 hours to complete.</li>
    </customEffectDescriptions>
    <geneClass>EBSGFramework.HediffAdder</geneClass>
    <!-- Placeholder icon. -->
    <iconPath>UI/Icons/Genes/CatIcon</iconPath>
    <displayCategory>Archite</displayCategory>
    <displayOrderInCategory>950</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <biostatArc>2</biostatArc>
    <selectionWeight>0</selectionWeight>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <!-- Shared with vanilla Deathless via Patch_DeathlessExclusion.xml, so the two conflict. -->
    <exclusionTags>
      <li>DZ_NineLives_Deathless</li>
    </exclusionTags>
    <descriptionHyperlinks>
      <HediffDef>DZ_NineLives</HediffDef>
    </descriptionHyperlinks>
    <modExtensions>
      <li Class="EBSGFramework.EBSGExtension">
        <hediffsToApply>
          <li>
            <hediff>DZ_NineLives</hediff>
            <onlyIfNew>true</onlyIfNew>
            <severity>1</severity>
          </li>
        </hediffsToApply>
        <vanishingGene>false</vanishingGene>
      </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>DZ_NineLives</defName>
    <label>nine lives</label>
    <description>Feline archites cling to this person's soul. When they die the archites rebuild the body, up to eight times.</description>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <minSeverity>0.01</minSeverity>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <label>one revive left</label>
        <minSeverity>0.0005</minSeverity>
      </li>
      <li>
        <label>two revives left</label>
        <minSeverity>0.1254</minSeverity>
      </li>
      <li>
        <label>three revives left</label>
        <minSeverity>0.2502</minSeverity>
      </li>
      <li>
        <label>four revives left</label>
        <minSeverity>0.3751</minSeverity>
      </li>
      <li>
        <label>five revives left</label>
        <minSeverity>0.5000</minSeverity>
      </li>
      <li>
        <label>six revives left</label>
        <minSeverity>0.6249</minSeverity>
      </li>
      <li>
        <label>seven revives left</label>
        <minSeverity>0.7497</minSeverity>
      </li>
      <li>
        <label>eight revives left</label>
        <minSeverity>0.8746</minSeverity>
      </li>
    </stages>
    <comps>
      <li Class="EBSGFramework.HediffCompProperties_MultipleLives">
        <extraLives>8</extraLives>
        <hoursToRevive>12</hoursToRevive>
        <needBrainToRevive>true</needBrainToRevive>
        <useSeverityNotDays>true</useSeverityNotDays>
      </li>
    </comps>
  </HediffDef>

</Defs>
